{
  "name": "@production-master/mcp-tool-router",
  "version": "0.1.0",
  "description": "Maps investigation.* MCP tool calls onto the Production Master public /v1/* REST API. Zero IP: validates arguments against the shared tool contract and forwards the caller's bearer opaquely; performs no scope decisions of its own (AD-23 \u00a75) \u2014 those are enforced server-side by the hosted service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@production-master/mcp-tool-contract": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProductionMasterAI/production-master-mcp.git",
    "directory": "packages/mcp-tool-router"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "production-master"
  ],
  "license": "MIT",
  "author": "Tamir Cohen <tamircohen2468@gmail.com>",
  "homepage": "https://github.com/ProductionMasterAI/production-master-mcp#readme",
  "bugs": {
    "url": "https://github.com/ProductionMasterAI/production-master-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
